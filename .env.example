# All keys are optional. Keyless sources (Met, Art Institute of Chicago,
# Cleveland Museum of Art, V&A, Wikidata) work without any configuration.
# See docs/setup/api-keys.md for how to obtain each key.

# Harvard Art Museums — https://harvardartmuseums.org/collections/api
HARVARD_API_KEY=

# Europeana — https://pro.europeana.eu/page/get-api
EUROPEANA_API_KEY=

# Smithsonian Open Access via api.data.gov — https://api.data.gov/signup/
SMITHSONIAN_API_KEY=
